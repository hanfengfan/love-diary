# ============================================
# Love Diary Frontend - 多阶段构建
# ============================================

# 阶段1: 构建 Vue 前端
FROM node:18-alpine AS builder

WORKDIR /app

# 先复制依赖文件，利用缓存
COPY love-diary-frontend/package.json love-diary-frontend/package-lock.json* ./
RUN npm install

# 复制前端源码并构建
COPY love-diary-frontend/ .
RUN npm run build

# 阶段2: Nginx 提供静态文件服务
FROM nginx:alpine

# 安装 gettext 提供 envsubst 工具（用于替换环境变量）
RUN apk add --no-cache gettext

# 删除默认配置
RUN rm /etc/nginx/conf.d/default.conf

# 从构建阶段复制编译好的前端文件
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 Nginx 模板配置（含 ${DOMAIN} 占位符）
COPY nginx/nginx.conf /etc/nginx/templates/default.conf.template

# 创建 Certbot webroot 目录
RUN mkdir -p /var/www/certbot

EXPOSE 80 443

# 启动时渲染 nginx 配置模板：
#   - 只替换 ${DOMAIN}，不影响 nginx 内置变量（$host/$uri 等）
#   - nginx -t 进行配置自检，出错时可看到明确日志
CMD ["/bin/sh", "-c", "export DOMAIN=${DOMAIN:-loveforever.mooo.com} && envsubst '$DOMAIN' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -t && nginx -g 'daemon off;'"]

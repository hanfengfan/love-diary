# ====================================
# 恋爱日记网站 - 环境变量配置
# 使用前请复制此文件为 .env 并修改
# cp .env.example .env
# ====================================

# Flask 密钥（必须修改为随机字符串！）
SECRET_KEY=请修改为一个随机的长字符串

# 管理员初始密码
ADMIN_PASSWORD=请修改为你的管理员密码

# 允许的前端域名（CORS）
CORS_ORIGINS=https://loveforever.mooo.com

# SSL 证书邮箱（用于 Let's Encrypt 通知）
CERTBOT_EMAIL=your-email@example.com
